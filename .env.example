# Template for the local .env file (committed; safe to share).
# Copy this to `.env` and fill in your own credentials.
# `.env` itself is gitignored — never commit secrets.

# --- MLflow ------------------------------------------------------------------
# Use 127.0.0.1 instead of localhost on Windows (IPv6/cp1252 quirks).
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
MLFLOW_TRACKING_USERNAME=your_username
MLFLOW_TRACKING_PASSWORD=your_password

PADS_MLFLOW_EXPERIMENT=pads_retraining
PADS_RUN_TAGS=environment=local,operator=your_name

# --- Windows / TensorFlow workarounds ----------------------------------------
# MLflow prints unicode emojis when closing a run; force UTF-8 stdout.
PYTHONIOENCODING=utf-8
PYTHONUTF8=1

# Silence the oneDNN float-rounding warning at TensorFlow startup.
TF_ENABLE_ONEDNN_OPTS=0
